@startuml CU-23_EvaluacionOrganizacionVinculada
!include _comun.puml
title CU-23 Evaluacion de la Organizacion Vinculada

actor Practicante
boundary ":GUIAddOVEvaluation" as UI
participant ":AddOVEvaluationController" as C
participant "ovEvaluation : OVEvaluation" as DTO
participant ":OVEvaluationDAO" as ODAO
participant ":EvaluationPrerequisiteChecker" as CHK
participant ":ReportEvaluationDAO" as REDAO
participant ":PracticeDAO" as PDAO
database "BD" as BD

Practicante -> UI : seleccionar PDF y clic en "Subir"
activate UI
UI -> C : processSelectedFile(file)
activate C

alt [!isPDF(file)]
    C -> UI : showStatus("El archivo seleccionado no es un PDF válido.")
    UI --> Practicante : muestra estado
else [PDF válido]
    C -> C : copyFile()
    create DTO
    C -> DTO : new OVEvaluation()
    activate DTO
    C -> DTO : setIdIntern(internId)
    C -> DTO : setIdProject(projectId)
    C -> DTO : setDocumentPath(filePath)
    C -> DTO : setStatus("Entregada")
    C -> DTO : setDeliveryDate(LocalDateTime.now())

    C -> ODAO : save(ovEvaluation)
    activate ODAO
    ODAO -> DTO : getIdIntern() / getIdProject() / getDocumentPath() / ...
    DTO --> ODAO : valores
    ODAO -> BD : INSERT INTO evaluacion_ov (...)
    activate BD
    BD --> ODAO : filas afectadas
    deactivate BD
    ODAO --> C : int (rowsAffected)
    deactivate ODAO
    deactivate DTO

    alt [rowsAffected > 0]
        C -> UI : showAlert("Evaluación OV entregada", "La evaluación OV fue registrada.", INFORMATION)
        UI --> Practicante : muestra diálogo

        C -> CHK : isPracticeComplete(internId, projectId)
        activate CHK
        CHK -> BD : SELECT reportes y evaluaciones
        BD --> CHK : boolean
        CHK --> C : boolean
        deactivate CHK

        opt [practica completa]
            C -> REDAO : getAveragePracticeGrade(internId)
            activate REDAO
            REDAO -> BD : SELECT AVG(calificacion)
            BD --> REDAO : Double
            REDAO --> C : Double
            deactivate REDAO
            C -> PDAO : concludeActiveByIntern(internId, practiceGrade)
            activate PDAO
            PDAO -> BD : UPDATE practica SET estado='Concluida', calificacion=?
            BD --> PDAO : boolean
            PDAO --> C : boolean
            deactivate PDAO
            C -> UI : showAlert("Práctica concluida", "Cumplió todos los requisitos.", INFORMATION)
            UI --> Practicante : muestra diálogo
        end
    else [DuplicateEntryException]
        C -> UI : showAlert("Evaluación OV ya entregada", "Ya existe una evaluación OV para este proyecto.", WARNING)
        UI --> Practicante : muestra diálogo
    else [ServiceException]
        C -> UI : showAlert("Servicio no disponible", "Intente más tarde.", ERROR)
        UI --> Practicante : muestra diálogo
    else [IOException]
        C -> UI : showAlert("Error de archivo", "No se pudo copiar el archivo.", ERROR)
        UI --> Practicante : muestra diálogo
    end
end
deactivate C
deactivate UI
@enduml
