@startuml
!pragma layout smetana
hide empty description
skinparam shadowing false
skinparam state {
  BackgroundColor #D5E8F0
  BorderColor #2E6FA3
  FontColor #1A3C53
  ArrowColor #2E6FA3
}
title CU-06 Consultar Organizacion Vinculada
state "Lista mostrada" as ListaMostrada
state "Sin registros" as SinRegistros
[*] --> Cargando : / findAll() : List<LinkedOrganization>
Cargando --> ListaMostrada : [hay registros] / tableView.setAll(organizations)
Cargando --> SinRegistros : [lista vacia] / showAlert("Sin registros", INFORMATION)
Cargando --> Error : [ServiceException] / showAlert("Error de servicio", ERROR)
ListaMostrada --> [*]
SinRegistros --> [*]
Error --> [*]
@enduml
