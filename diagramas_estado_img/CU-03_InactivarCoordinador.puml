@startuml
!pragma layout smetana
!include _estilo.iuml
hide empty description
title CU-03 Inactivar Coordinador
state "Activo" as Activo
Activo : entry / loadCoordinators()
state "Por confirmar" as Conf
Conf : entry / showAlertAndWait(CONFIRMATION)
state "Inactivando" as Inact
Inact : entry / updateUserRolStatus(user)
state "Inactivo" as Off
Off : entry / showAlert("Coordinador desactivado", INFORMATION)
state "Error" as Error
Error : entry / showAlert("Error", ERROR)
[*] --> Activo
Activo --> Conf : inactivateCoordinator [coordinador seleccionado]
Activo --> Activo : inactivateCoordinator [sin seleccion] / showAlert("Sin seleccion")
Conf --> Inact : [response == OK]
Conf --> Activo : [cancela]
Inact --> Off : [exito]
Inact --> Error : [ServiceException / ValidationException]
Off --> [*]
Error --> Activo : [reintentar]
@enduml
