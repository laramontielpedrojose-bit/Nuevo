@startuml
!pragma layout smetana
!include _estilo.iuml
hide empty description
title CU-07 Registrar Tecnico Responsable
state "Capturando" as Cap
Cap : entry / loadLinkedOrganization()
state "Validando" as Val
Val : entry / hasEmptyFields()
state "Guardando" as Guard
Guard : entry / saveTechnicalResponsible(technical)
state "Registrado" as Reg
Reg : entry / showAlert("Registro exitoso", INFORMATION)
Reg : exit / clearFields()
[*] --> Cap
Cap --> Val : addTechnical
Val --> Cap : [campos vacios / email invalido] / showAlert(WARNING)
Val --> Guard : [datos validos]
Guard --> Reg : [exito]
Guard --> Cap : [fallo / duplicado] / showAlert(ERROR)
Reg --> [*]
@enduml
