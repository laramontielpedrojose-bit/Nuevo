@startuml
!pragma layout smetana
!include _estilo.iuml
hide empty description
title CU-13 Inactivar Practicante
state "Activo" as Activo
Activo : entry / loadActiveInterns()
state "Por confirmar" as Conf
Conf : entry / showAlertAndWait(CONFIRMATION)
state "Inactivando" as Inact
Inact : entry / deactivateIntern(user.getId())
state "Inactivo" as Off
Off : entry / actualiza la tabla
state "Error" as Error
Error : entry / showAlert("Error", ERROR)
[*] --> Activo
Activo --> Conf : inactivateIntern [practicante seleccionado]
Activo --> Activo : inactivateIntern [sin seleccion] / showAlert("Sin seleccion")
Conf --> Inact : [response == OK]
Conf --> Activo : [cancela]
Inact --> Off : [exito]
Inact --> Error : [ServiceException / ValidationException]
Off --> [*]
Error --> Activo : [reintentar]
@enduml
