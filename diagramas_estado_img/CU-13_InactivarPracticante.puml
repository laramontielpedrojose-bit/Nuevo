@startuml
!pragma layout smetana
hide empty description
skinparam shadowing false
skinparam state {
  BackgroundColor #D5E8F0
  BorderColor #2E6FA3
  FontColor #1A3C53
  ArrowColor #2E6FA3
}
title CU-13 Inactivar Practicante
state "Por confirmar" as PorConfirmar
[*] --> Activo
Activo --> PorConfirmar : inactivateIntern [practicante seleccionado] / showAlertAndWait(CONFIRMATION)
Activo --> Activo : inactivateIntern [sin seleccion] / showAlert("Sin seleccion", WARNING)
PorConfirmar --> Inactivando : [response == OK] / deactivateIntern(user.getId())
PorConfirmar --> Activo : [cancela]
Inactivando --> Inactivo : [exito]
Inactivando --> Error : [ServiceException / ValidationException] / showAlert("Error", ERROR)
Inactivo --> [*] : / loadActiveInterns()
Error --> Activo : [reintentar]
@enduml
